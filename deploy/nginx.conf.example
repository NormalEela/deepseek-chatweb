# chat-demo 的 nginx 反向代理示例
#
# 安装：
#   sudo cp deploy/nginx.conf.example /etc/nginx/conf.d/chat-demo.conf
#   sudo nano /etc/nginx/conf.d/chat-demo.conf   # 把 example.com 换成你的域名或服务器 IP
#   sudo nginx -t && sudo systemctl reload nginx
#
# 同时把 systemd 里的 HOST 改为 127.0.0.1，让 Node 只接受 nginx 的请求。
# HTTPS：sudo apt-get install -y certbot python3-certbot-nginx && sudo certbot --nginx -d 你的域名

server {
    listen 80;
    # 没有域名时可以直接写服务器 IP；也可以用 `server_name _;`
    server_name example.com;

    # 附件上传：与应用内的 64MB 上限留出余量
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # 流式回答（SSE）必须关闭缓冲，否则会一次性输出
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
